{
  "name": "hexatune",
  "productName": "HexaTune",
  "version": "1.0.0",
  "description": "Windows 10/11 向けのPC最適化ツール",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.hexatune.app",
    "productName": "HexaTune",
    "files": [
      "main.js",
      "preload.js",
      "engine/**",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HexaTune",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.17.0"
  }
}
